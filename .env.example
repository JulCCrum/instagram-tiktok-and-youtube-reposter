# Instagram credentials (account to repost FROM)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# TikTok credentials (account to repost TO)
TIKTOK_USERNAME=your_tiktok_username
TIKTOK_PASSWORD=your_tiktok_password
TIKTOK_ACCOUNT_NAME=your_tiktok_handle

# Optional: anthropic API key if you want AI-generated captions
# ANTHROPIC_API_KEY=your_api_key

# Failure alerts use native macOS desktop notifications — no credentials needed.
# For reliable alerts from the cron job, install: brew install terminal-notifier
